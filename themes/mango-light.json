        "sidebar.primary.background": "#f1840b",
        "sidebar.primary.foreground": "#211209",
        "tab.background": "#f1ece600",
        "tab.foreground": "#5e5650",
        "tab.active.background": "#fcfbf8",
        "tab.active.foreground": "#201914",
