          "attribute": {
            "color": "#a64a00"
          },
          "boolean": {
            "color": "#9c3b96"
          },
          "comment": {
            "color": "#5e5650",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "#5e5650",
            "font_style": "italic"
          },
          "constant": {
            "color": "#9c3b96"
          },
          "constructor": {
            "color": "#076d76"
          },
          "embedded": {
            "color": "#201914"
          },
          "function": {
            "color": "#a64a00"
          },
          "keyword": {
            "color": "#ba2c25"
          },
          "link_text": {
            "color": "#3762b5",
            "font_style": "underline"
          },
          "link_uri": {
            "color": "#3762b5",
            "font_style": "italic"
          },
          "number": {
            "color": "#855a03"
          },
          "property": {
            "color": "#3762b5"
          },
          "string": {
            "color": "#296f23"
          },
          "string.escape": {
            "color": "#ba2c25"
          },
          "string.regex": {
            "color": "#076d76"
          },
          "string.special": {
            "color": "#ba2c25"
          },
          "string.special.symbol": {
            "color": "#9c3b96"
          },
          "tag": {
            "color": "#a64a00"
          },
          "text.literal": {
            "color": "#296f23"
          },
          "title": {
            "color": "#a64a00",
            "font_weight": 600
          },
          "type": {
            "color": "#076d76"
          },
          "variable.special": {
            "color": "#9c3b96"
          }
        }
